# ============================================================================
# AI Trading Brain -- environment configuration
# Copy to `.env` (git-ignored) and fill in. NOTHING here is required to run:
# with no keys at all the app runs on the CSV cache + clearly-labelled
# SYNTHETIC data provider so development and testing never block.
# ============================================================================

# --- Storage ---------------------------------------------------------------
# Research artefacts: knowledge base, hypotheses, experiments, journal, strategies.
# Stays small; copy it around freely.
BRAIN_DB=./data_cache/brain.db

# Market data: bars, ticks, corporate actions, options, and every derived
# feature. This is the one that grows into the gigabytes, which is why it is a
# separate file.
BRAIN_MARKET_DB=./data_cache/market.db

# Directory for CSV imports and anything else cached on disk.
BRAIN_CACHE_DIR=./data_cache

# ============================================================================
# MARKET DATA INFRASTRUCTURE
# ============================================================================
# Two separate orders, because reading and fetching are different jobs.
#
# READ path: what the engines (backtester, screener, analyzer, charts) use.
# "db" is first so every read hits the local store. A miss triggers a persisted
# backfill, never a throwaway fetch.
BRAIN_PROVIDER_ORDER=db,alpaca,csv,stooq,yahoo,tiingo,polygon,synthetic

# INGEST path: which vendors the ingestion service is allowed to buy data from.
#   alpaca    bars, trades, quotes, corporate actions, options, realtime stream
#   tiingo    daily + intraday, requires TIINGO_API_KEY
#   polygon   daily + intraday + options, requires POLYGON_API_KEY
#   stooq     free EOD daily bars, no key                (needs network egress)
#   yahoo     free daily + intraday, no key              (needs network egress)
#   csv       local CSVs in $BRAIN_CACHE_DIR/daily/<SYMBOL>.csv (offline)
#   synthetic deterministic generated bars, ALWAYS labelled SYNTHETIC
BRAIN_INGEST_PROVIDER_ORDER=alpaca,tiingo,polygon,stooq,yahoo,csv,synthetic

# When the store misses a range, fetch it once and persist it. Set false for a
# strictly offline system: a miss then becomes an error naming what to backfill.
BRAIN_ALLOW_ONDEMAND_BACKFILL=true

# How much history a new symbol gets on first backfill.
BRAIN_HISTORY_YEARS=5

# Symbols per batched vendor request. Higher = fewer API calls.
BRAIN_INGEST_BATCH_SYMBOLS=100
# Cap the tracked universe (0 = no cap). Useful on a free data plan.
BRAIN_INGEST_MAX_SYMBOLS=0

# --- Alpaca ----------------------------------------------------------------
# The first-class provider. Credentials are read by the BACKEND ONLY and are
# never returned by any API route -- the data control centre reports presence,
# never value.  https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_API_SECRET=

# iex  = free tier. A SINGLE EXCHANGE carrying a low single-digit share of
#        consolidated US volume. Volume, relative volume and liquidity filters
#        computed from it understate the real market. The UI labels it PARTIAL.
# sip  = consolidated tape, all US exchanges (paid subscription).
# delayed_sip = consolidated but 15 minutes late.
ALPACA_DATA_FEED=iex

# Use the paper trading host for the asset/universe endpoint.
ALPACA_PAPER=true

# --- Real-time streaming ---------------------------------------------------
# WebSocket ingestion: subscribes, aggregates to 1-minute bars, derives
# 5m/15m/1h, reconnects with exponential backoff, detects duplicates and gaps.
BRAIN_REALTIME_ENABLED=false
# Blank = the first 30 tracked symbols.
BRAIN_REALTIME_SYMBOLS=
# bars | trades | quotes (comma separated). Bars alone is much cheaper.
BRAIN_REALTIME_CHANNELS=bars
# Keeping every tick is the fastest route to a 100GB database. Off by default.
BRAIN_STORE_RAW_TICKS=false
BRAIN_RAW_TICK_RETENTION_DAYS=5
BRAIN_RECONNECT_MAX_BACKOFF=60

# Tiingo -- daily/intraday equities history. Free tier available.
# https://www.tiingo.com/account/api/token
TIINGO_API_KEY=

# Polygon.io -- equities aggregates, intraday and the options chain used by
# OPTIONS LAB for real bid/ask/OI/IV. Without it the options module runs on
# model estimates only (clearly labelled MODEL_ESTIMATE).
# https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=

# Finnhub -- optional fundamentals/earnings-calendar provider.
FINNHUB_API_KEY=

# NewsAPI -- optional news provider for the episodic-pivot catalyst check.
NEWS_API_KEY=

# --- AI orchestration ------------------------------------------------------
# The AI Brain works WITHOUT this key: it falls back to a deterministic intent
# router that calls the same tools. The key only adds natural-language framing.
# The LLM is never allowed to produce numbers itself -- all figures come from
# tool calls against real engines.
ANTHROPIC_API_KEY=
BRAIN_LLM_MODEL=claude-opus-5
BRAIN_LLM_ENABLED=true

# --- Backtest execution assumptions ---------------------------------------
BRAIN_COMMISSION_PER_SHARE=0.0
BRAIN_COMMISSION_MIN=0.0
BRAIN_SLIPPAGE_BPS=5.0

# --- Trading safety (live trading is OFF and must stay off by default) -----
BRAIN_LIVE_TRADING_ENABLED=false
BRAIN_KILL_SWITCH=false
BRAIN_MAX_DAILY_LOSS_PCT=3.0
BRAIN_MAX_POSITION_PCT=20.0
BRAIN_MAX_ORDER_NOTIONAL=5000

# --- Server ----------------------------------------------------------------
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8787
