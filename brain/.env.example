# ============================================================================
# AI Trading Brain -- environment configuration
# Copy to `.env` (git-ignored) and fill in. NOTHING here is required to run:
# with no keys at all the app runs on the CSV cache + clearly-labelled
# SYNTHETIC data provider so development and testing never block.
# ============================================================================

# --- Storage ---------------------------------------------------------------
# SQLite file holding knowledge base, hypotheses, experiments, journal, strategies.
BRAIN_DB=./data_cache/brain.db
# Directory for cached vendor CSVs and downloaded price history.
BRAIN_CACHE_DIR=./data_cache

# --- Market data providers -------------------------------------------------
# Preference order tried left-to-right. First one configured AND reachable wins.
#   csv       local CSVs in $BRAIN_CACHE_DIR/daily/<SYMBOL>.csv   (no key, works offline)
#   stooq     free EOD daily bars, no key required                (needs network egress)
#   yahoo     free daily + intraday chart API, no key required    (needs network egress)
#   tiingo    daily + intraday, requires TIINGO_API_KEY
#   polygon   daily + intraday + options, requires POLYGON_API_KEY
#   synthetic deterministic generated bars, ALWAYS labelled SYNTHETIC, never tradeable
BRAIN_PROVIDER_ORDER=csv,stooq,yahoo,tiingo,polygon,synthetic

# Tiingo -- daily/intraday equities history. Free tier available.
# https://www.tiingo.com/account/api/token
TIINGO_API_KEY=

# Polygon.io -- equities aggregates, intraday and the options chain used by
# OPTIONS LAB for real bid/ask/OI/IV. Without it the options module runs on
# model estimates only (clearly labelled MODEL_ESTIMATE).
# https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=

# Alpaca -- alternative market data + (future) paper broker integration.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Finnhub -- optional fundamentals/earnings-calendar provider.
FINNHUB_API_KEY=

# NewsAPI -- optional news provider for the episodic-pivot catalyst check.
NEWS_API_KEY=

# --- AI orchestration ------------------------------------------------------
# The AI Brain works WITHOUT this key: it falls back to a deterministic intent
# router that calls the same tools. The key only adds natural-language framing.
# The LLM is never allowed to produce numbers itself -- all figures come from
# tool calls against real engines.
ANTHROPIC_API_KEY=
BRAIN_LLM_MODEL=claude-opus-5
BRAIN_LLM_ENABLED=true

# --- Backtest execution assumptions ---------------------------------------
BRAIN_COMMISSION_PER_SHARE=0.0
BRAIN_COMMISSION_MIN=0.0
BRAIN_SLIPPAGE_BPS=5.0

# --- Trading safety (live trading is OFF and must stay off by default) -----
BRAIN_LIVE_TRADING_ENABLED=false
BRAIN_KILL_SWITCH=false
BRAIN_MAX_DAILY_LOSS_PCT=3.0
BRAIN_MAX_POSITION_PCT=20.0
BRAIN_MAX_ORDER_NOTIONAL=5000

# --- Server ----------------------------------------------------------------
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8787
